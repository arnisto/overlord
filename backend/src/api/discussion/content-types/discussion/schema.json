{
  "kind": "collectionType",
  "collectionName": "discussions",
  "info": {
    "singularName": "discussion",
    "pluralName": "discussions",
    "displayName": "Discussion",
    "description": "Question ou discussion lancée par un membre"
  },
  "options": {
    "draftAndPublish": false
  },
  "indexes": [
    {
      "name": "discussions_slug_unique",
      "columns": [
        "slug"
      ],
      "type": "unique"
    },
    {
      "name": "discussions_created_at_index",
      "columns": [
        "created_at"
      ]
    }
  ],
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 10,
      "maxLength": 200
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "content": {
      "type": "text",
      "required": true,
      "maxLength": 10000
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "question",
        "discussion"
      ],
      "required": true,
      "default": "question"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "discussions"
    },
    "replies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::reply.reply",
      "mappedBy": "discussion"
    },
    "bestReply": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::reply.reply"
    }
  }
}
