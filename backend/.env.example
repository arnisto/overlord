# Serveur
HOST=0.0.0.0
PORT=1337

# Secrets — générer des valeurs aléatoires, par exemple : openssl rand -base64 32
APP_KEYS=changeme1,changeme2
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
JWT_SECRET=changeme
ENCRYPTION_KEY=changeme

# Base PostgreSQL (docker compose expose Postgres sur le port 5434)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
DATABASE_NAME=lerevenu
DATABASE_USERNAME=lerevenu
DATABASE_PASSWORD=lerevenu
DATABASE_SSL=false

# Données de démonstration (créées au démarrage si la base est vide)
SEED_DEMO=true
DEMO_USER_PASSWORD=Demo1234!

# Authentification Users & Permissions
JWT_EXPIRES_IN=7d
AUTH_RATELIMIT_MAX=10
